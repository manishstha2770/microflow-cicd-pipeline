# Local development template. Review before copying to an ignored .env file.
# These settings are reserved for the application and Compose phases.
COMPOSE_PROJECT_NAME=microflow
POSTGRES_USER=microflow_local_admin
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# A local file path for a private JWT signing key, kept outside version control.
JWT_SIGNING_KEY_FILE=./.secrets/jwt-signing.pem
